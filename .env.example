# Online Headbands lobbies (optional). Copy to .env.local and fill in from
# Firebase console → Project settings → Your apps → Web app config.
# These values are public by design; the database rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local testing with `npx firebase-tools emulators:start --only database`:
# VITE_FIREBASE_EMULATOR=localhost:9000
