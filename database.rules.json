              "answers": {
                "$i": {
                  ".validate": "newData.hasChildren(['text', 'points']) && $i.matches(/^[0-9]$/)",
                  "text": {
                    ".validate": "newData.isString() && newData.val().length <= 60"
                  },
                  "points": {
                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "board": {
          "$id": {
            ".validate": "newData.hasChildren(['s', 'at'])",
            "s": {
              ".validate": "newData.isString() && newData.val().matches(/^(airhorn|drumroll|sadTrombone|applause|boing|rimshot|win|wrong)$/)"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "chat": {
          "$id": {
            ".validate": "newData.hasChildren(['n', 't', 'at'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "s": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,24}$/) && (newData.val() !== 'zuno' || (auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'itzdutchs@gmail.com'))"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "profiles": {
      ".read": "(auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'itzdutchs@gmail.com')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "username": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24 && root.child('usernames').child(newData.val().toLowerCase()).val() === $uid"
        },
        "avatar": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 21000 && !newData.val().contains('\\\\') && (!newData.val().contains('\"zuno\"') || (auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'itzdutchs@gmail.com'))"
        },
        "createdAt": {
          ".read": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "email": {
          ".validate": "newData.isString() && auth != null && auth.token.email != null && newData.val() === auth.token.email.toLowerCase()"
        },
        "sidebar": {
          ".validate": "newData.isString() && newData.val().matches(/^(left|top|right|bottom)$/)"
        },
        "equippedDecoration": {
          ".read": "auth != null",
          ".write": "(auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'itzdutchs@gmail.com')",
          ".validate": "newData.isString() && (newData.val().matches(/^(ring|dashed)$/) || (newData.val().matches(/^(first-game|regular|explorer)$/) && newData.parent().child('achievements').child(newData.val()).child('at').isNumber()) || (newData.val() !== 'zuno' && root.child('grants').child($uid).child('decorations').child(newData.val()).val() === true) || (newData.val() === 'zuno' && auth.uid === $uid && (auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'itzdutchs@gmail.com')))"
        },
        "equippedNameStyle": {
          ".read": "auth != null",
          ".write": "(auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'itzdutchs@gmail.com')",
          ".validate": "newData.isString() && (newData.val().matches(/^(bold|accent)$/) || (newData.val().matches(/^(host|builder|stylist)$/) && newData.parent().child('achievements').child(newData.val()).child('at').isNumber()) || (newData.val() !== 'zuno' && root.child('grants').child($uid).child('nameStyles').child(newData.val()).val() === true) || (newData.val() === 'zuno' && auth.uid === $uid && (auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'itzdutchs@gmail.com')))"
        },
        "achievements": {
          ".read": "auth != null",
          "$id": {
            ".validate": "$id.matches(/^[a-z0-9-]{1,24}$/) && newData.hasChild('count')",
            "count": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "seen": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "grants": {
      ".read": "(auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'itzdutchs@gmail.com')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'itzdutchs@gmail.com')",
        "$kind": {
          ".validate": "$kind === 'decorations' || $kind === 'nameStyles'",
          "$id": {
            ".validate": "newData.val() === true && $id.matches(/^[a-z0-9-]{1,24}$/) && ($id !== 'zuno' || $uid === auth.uid)"
          }
        }
      }
    },
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)",
        ".validate": "$name.length >= 2 && $name.length <= 24"
      }
    }
  }
}
